{
  "name": "marker",
  "pen": "freehand",
  "colors": {
    "ink": "#E5484D",
    "accent": "#2F6FEB",
    "highlight": "#FFD43B",
    "paper": "#FFFFFF",
    "shade": "#14141A"
  },
  "dark": {
    "colors": {
      "ink": "#FF6B70",
      "accent": "#7FA8FF",
      "highlight": "#FFD43B",
      "paper": "#101012",
      "shade": "#000000"
    }
  },
  "defaults": {
    "stroke": "ink",
    "highlight": "highlight",
    "label": "ink",
    "paper": "paper"
  },
  "stroke": {
    "width": 6,
    "roughness": 1.2,
    "bowing": 1,
    "thinning": 0.5,
    "highlightWidth": 28
  },
  "font": {
    "family": "\"Permanent Marker\", \"Segoe Print\", cursive",
    "size": 34,
    "weight": 400,
    "lineHeight": 1.15
  },
  "overlay": {
    "opacity": 0.6,
    "color": "shade",
    "pad": 10,
    "radius": 12,
    "fade": 0.3
  },
  "timing": {
    "durations": {
      "circle": 0.7,
      "box": 0.8,
      "underline": 0.45,
      "highlight": 0.5,
      "strike": 0.35,
      "bracket": 0.5,
      "arrow": 0.6,
      "label": 0.4,
      "scribble": 0.8
    },
    "labelPerChar": 0.035,
    "hold": 1.2,
    "gap": 0.15,
    "easing": "inOutQuad"
  }
}
