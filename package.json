{
  "name": "inkmark",
  "version": "0.1.0",
  "private": true,
  "description": "Hand-drawn annotations over UI, text, photos and charts, played step by step. One JSON scene gives a web player, PNGs and an MP4.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "inkmark": "node cli/index.ts",
    "demo:media": "node cli/media.ts"
  },
  "dependencies": {
    "@fontsource/permanent-marker": "^5.3.0",
    "@radix-ui/react-accordion": "^1.3.1",
    "animejs": "^4.5.0",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/reenie-beanie": "^5.3.0",
    "@fontsource/shadows-into-light": "^5.3.0",
    "@radix-ui/react-tooltip": "1.4.1",
    "@types/node": "^26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "dialkit": "2.1.0",
    "lucide-react": "1.66.0",
    "motion": "14.9.0",
    "playwright-core": "^1.64.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
