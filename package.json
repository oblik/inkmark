{
  "name": "marginalia",
  "version": "0.1.0",
  "private": true,
  "description": "Hand-drawn annotations over UI, text, photos and charts, played step by step. One JSON scene gives a web player, PNGs and an MP4.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build -c vite.lib.config.ts",
    "build:demo": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"test/**/*.test.ts\"",
    "marginalia": "node cli/index.ts"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "perfect-freehand": "^1.2.3",
    "roughjs": "^4.6.6"
  },
  "devDependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource/gochi-hand": "^5.3.0",
    "@fontsource/kalam": "^5.3.0",
    "@fontsource/patrick-hand": "^5.3.0",
    "@fontsource/permanent-marker": "^5.3.0",
    "@fontsource/reenie-beanie": "^5.3.0",
    "@fontsource/shadows-into-light": "^5.3.0",
    "@types/node": "^26.6.5",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  }
}
